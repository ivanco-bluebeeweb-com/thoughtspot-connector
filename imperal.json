{
  "manifest_schema_version": 3,
  "sdk_version": "5.11.0",
  "app_id": "thoughtspot-connector",
  "version": "0.1.0",
  "name": "ThoughtSpot",
  "description": "Connect your own ThoughtSpot instance to manage Liveboards, Answers, Worksheets and run natural-language search queries from Imperal -- export reports, monitor content by tag, and get instance health at a glance. Nothing is hosted or proxied by Imperal beyond the request itself.",
  "icon": "icon.svg",
  "actions_explicit": true,
  "system": false,
  "capabilities": [
    "thoughtspot:read",
    "thoughtspot:write"
  ],
  "tools": [
    {
      "name": "connect_thoughtspot",
      "description": "Connect a ThoughtSpot instance via username/password, after validating the credentials actually work (logs in).",
      "action_type": "write",
      "chain_callable": true,
      "effects": [
        "create:connection"
      ],
      "id_projection": "",
      "params_schema": {
        "properties": {
          "instance_hostname": {
            "description": "ThoughtSpot instance hostname, e.g. myorg.thoughtspot.cloud",
            "title": "Instance Hostname",
            "type": "string"
          },
          "username": {
            "description": "ThoughtSpot username (or service account username).",
            "title": "Username",
            "type": "string"
          },
          "password": {
            "description": "ThoughtSpot password (or service account secret).",
            "title": "Password",
            "type": "string"
          },
          "label": {
            "default": "",
            "description": "Optional friendly label, e.g. 'Production instance'.",
            "title": "Label",
            "type": "string"
          }
        },
        "required": [
          "instance_hostname",
          "username",
          "password"
        ],
        "title": "ConnectThoughtSpotParams",
        "type": "object"
      },
      "return_schema": {
        "properties": {
          "id": {
            "title": "Id",
            "type": "string"
          },
          "label": {
            "title": "Label",
            "type": "string"
          },
          "instance_hostname": {
            "title": "Instance Hostname",
            "type": "string"
          }
        },
        "required": [
          "id",
          "label",
          "instance_hostname"
        ],
        "title": "ConnectionInfo",
        "type": "object"
      },
      "event": "thoughtspot-connector.connected",
      "background": false,
      "long_running": false,
      "scopes": [],
      "owner_chat_tool": "tool_thoughtspot-connector_chat"
    },
    {
      "name": "disconnect_thoughtspot",
      "description": "Disconnect a ThoughtSpot instance: deletes only the saved credentials. Nothing in ThoughtSpot itself is changed.",
      "action_type": "write",
      "chain_callable": true,
      "effects": [
        "delete:connection"
      ],
      "id_projection": "",
      "params_schema": {
        "properties": {
          "connection_id": {
            "description": "Connection id from list_connections.",
            "title": "Connection Id",
            "type": "string"
          }
        },
        "required": [
          "connection_id"
        ],
        "title": "DisconnectThoughtSpotParams",
        "type": "object"
      },
      "return_schema": {
        "description": "Explicit empty params model -- V17 disallows untyped handlers.",
        "properties": {},
        "title": "NoParams",
        "type": "object"
      },
      "event": "thoughtspot-connector.disconnected",
      "background": false,
      "long_running": false,
      "scopes": [],
      "owner_chat_tool": "tool_thoughtspot-connector_chat"
    },
